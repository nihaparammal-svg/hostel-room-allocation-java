# ==============================================================================
# Hostel Management System - Environment Variables
# Copy this file to .env and configure your production credentials.
# Never commit real passwords to GitHub!
# ==============================================================================

# Spring Profile ('dev' for H2 in-memory or 'mysql' for production MySQL)
SPRING_PROFILES_ACTIVE=mysql

# MySQL Database Connection Details
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/hostel_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# Server Port
PORT=8080
