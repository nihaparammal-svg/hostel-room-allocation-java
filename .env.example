# ==============================================================================
# Hostel Management System - Environment Variables
# Copy this file to .env and configure your credentials.
# Never commit real passwords to GitHub!
# ==============================================================================

# Active Spring Profile: 'dev' (H2 in-memory), 'postgres' (Render / Cloud), or 'mysql'
SPRING_PROFILES_ACTIVE=postgres

# ------------------------------------------------------------------------------
# Option A: Render PostgreSQL Database (Recommended for Render)
# Render automatically injects DATABASE_URL when linking Web Service + Database
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://hostel_user:your_password@dpg-xxxxx-a.oregon-postgres.render.com:5432/hostel_db

# ------------------------------------------------------------------------------
# Option B: Standard PostgreSQL Connection (Manual or External)
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/hostel_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# ------------------------------------------------------------------------------
# Server Port (Render dynamically sets PORT to 10000; defaults to 8080 locally)
# ------------------------------------------------------------------------------
PORT=8080
